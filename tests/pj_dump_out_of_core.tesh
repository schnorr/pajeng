#!./tesh

# Out-of-core mode (-o) dumps and releases complete entities and
# containers every 100000 events. The container p0 is destroyed early;
# afterwards it still receives an event (ignored, since it is
# destroyed) and is the start container of a link that only completes
# after the release. Both used to touch freed memory.
$ sh -c "{ cat ../traces/out_of_core_prefix.trace; { seq 1 60000 | sed 's/.*/12 &.0 p1 ST a/'; seq 1 60000 | sed 's/.*/14 &.5 p1 ST/'; } | sort -k2,2g; echo '12 60001 p0 ST a'; echo '19 60002 0 LINK p1 c k1'; } > out_of_core.trace"

$ sh -c "./pj_dump -o out_of_core.trace | grep -v '^State,'"
> Container, 0, "PROCESS", 0, 0.6, 0.6, "p0"
> Link, 0, "LINK", 0.500000, 60002.000000, 60001.500000, c, "p0", "p1", k1
> Container, 0, "PROCESS", 0, 60002, 60002, "p1"

$ sh -c "./pj_dump -o out_of_core.trace | grep -c '^State,'"
> 60000

# Apart from the root container (not dumped in out-of-core mode), the
# output must be the same as the in-core one.
$ sh -c "./pj_dump out_of_core.trace | grep -v '^Container, 0, 0,' | sort > in_core.csv; ./pj_dump -o out_of_core.trace | sort > out_of_core.csv; cmp in_core.csv out_of_core.csv && echo identical"
> identical

$ rm out_of_core.trace in_core.csv out_of_core.csv
