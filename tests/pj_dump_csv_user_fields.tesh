#!./tesh

# User-defined fields (here, Mark) are only written with -u.
$ ./pj_dump_csv -u --prefix out ../traces/user_fields.trace
$ cat out.container.csv
> Container, Parent, Type, Start, End, Duration, Name
> Container, 0, 0, 0, 1, 1, 0
> Container, 0, "PROCESS", 0, 1, 1, "p1"
$ cat out.state.csv
> State, Container, Type, Start, End, Duration, Imbrication, Value, Mark
> State, "p1", "STATE", 0.100000, 1.000000, 0.900000, 0.000000, "A", mark1
> State, "p1", "STATE", 0.500000, 0.800000, 0.300000, 1.000000, "B", mark2
$ cat out.variable.csv
> Variable, Container, Type, Start, End, Duration, Value
$ cat out.event.csv
> Event, Container, Type, Time, Value
$ cat out.link.csv
> Link, Container, Type, Start, End, Duration, Value, StartContainer, EndContainer

$ rm out.container.csv out.state.csv out.variable.csv out.event.csv out.link.csv

$ ./pj_dump_csv --prefix out ../traces/user_fields.trace
$ cat out.container.csv
> Container, Parent, Type, Start, End, Duration, Name
> Container, 0, 0, 0, 1, 1, 0
> Container, 0, "PROCESS", 0, 1, 1, "p1"
$ cat out.state.csv
> State, Container, Type, Start, End, Duration, Imbrication, Value
> State, "p1", "STATE", 0.100000, 1.000000, 0.900000, 0.000000, "A"
> State, "p1", "STATE", 0.500000, 0.800000, 0.300000, 1.000000, "B"
$ cat out.variable.csv
> Variable, Container, Type, Start, End, Duration, Value
$ cat out.event.csv
> Event, Container, Type, Time, Value
$ cat out.link.csv
> Link, Container, Type, Start, End, Duration, Value, StartContainer, EndContainer

$ rm out.container.csv out.state.csv out.variable.csv out.event.csv out.link.csv
